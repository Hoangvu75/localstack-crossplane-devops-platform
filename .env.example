# ==============================================================================
# LocalStack + Crossplane DevOps Platform — environment variables
# ==============================================================================
# Copy to .env and fill in. .env is gitignored and is the only place a secret is
# entered by hand; scripts/00-manage-secrets.sh moves the token into AWS Secrets
# Manager, and scripts/03-bootstrap-gitops.sh copies it from there into the
# cluster as the `git-credentials` Secret that Tekton's push step mounts.

# LocalStack Pro authentication token. Required — EKS, CloudFront and ECR are all
# Pro-only, so without this scripts/01 stops with "eks not available".
LOCALSTACK_PAT=

# GitHub Personal Access Token with WRITE (repo) scope.
# Consumed by the Tekton pipeline's last task, which rewrites the image tags in
# gitops/workloads/*/kustomization.yaml and pushes the commit back, so ArgoCD can
# deploy the images that were just built. Read-only is not enough.
GITHUB_TOKEN=

# AWS configuration. The credentials are deliberately fake: LocalStack accepts any
# value, and scripts/_common.sh falls back to these when .env is absent.
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key
# From the HOST. Provider pods inside the cluster use http://localstack:4566 instead,
# set in gitops/infrastructure/provider/provider-config.yaml.
AWS_ENDPOINT=http://localhost:4566

# Repository the GitOps engine and the CI pipeline clone from. ArgoCD reads manifests
# from GitHub, never from this working copy, so changes have to be pushed to take effect.
GITHUB_REPO=github.com/Hoangvu75/localstack-crossplane-devops-platform.git
GITHUB_BRANCH=main
PROJECT_NAME=learn-crossplane
